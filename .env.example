# ==============================================================================
# Hiring Manager Evaluation Lab - Environment Configuration
# ==============================================================================

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# Local Storage Directory for Saved JSON Evaluation Traces
EVALUATION_DATA_DIR=data/evaluations

# Execution Limits & Timeouts
MODEL_TIMEOUT_SECONDS=60
MAX_INPUT_BYTES=1048576

# ------------------------------------------------------------------------------
# Model Provider 1: ChatGPT Paid / OpenAI API
# ------------------------------------------------------------------------------
# Provide your standard OpenAI API key (starts with sk-...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHATGPT_MODEL_ID=gpt-4o

# ------------------------------------------------------------------------------
# Model Provider 2: Qwen Model
# ------------------------------------------------------------------------------
# Compatible with Alibaba Cloud DashScope, vLLM, or OpenRouter
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL_ID=qwen-2.5-72b-instruct

# ------------------------------------------------------------------------------
# Model Provider 3: GPT-OSS 120B Model
# ------------------------------------------------------------------------------
# Compatible with self-hosted vLLM, Ollama, or OpenAI-compatible endpoint
GPT_OSS_API_KEY=
GPT_OSS_BASE_URL=
GPT_OSS_MODEL_ID=gpt-oss-120b
